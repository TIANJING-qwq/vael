{
  "manifest_version": 3,
  "name": "Bing 关键词演示",
  "version": "3.3",
  "description": "授权设备演示用。",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "*://*.bing.com/*",
    "http://127.0.0.1:18520/*",
    "*://seatmaps.com/*",
    "*://*.seatmaps.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bing.com/search*",
        "*://seatmaps.com/*",
        "*://*.seatmaps.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bing 关键词演示",
    "default_popup": "popup.html"
  }
}