<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">

    <UserControl.Styles>
        <!-- 现代卡片 -->
        <Style Selector="Border.info-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24,18"/>
        </Style>
        <!-- 信息行 -->
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.row-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 技术栈胶囊 -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#140078D4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Spacing="14">

            <!-- ============ Hero 卡 ============ -->
            <Border Classes="info-card">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Image Name="AppIcon"
                           Source="/Assets/app.png"
                           Width="84" Height="84"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Opacity="0" />

                    <StackPanel Name="TitlePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="2">
                        <TextBlock Name="Letter0" Text="V" FontSize="40" FontWeight="Bold" Foreground="#0067c0"/>
                        <TextBlock Name="Letter1" Text="a" FontSize="40" FontWeight="Bold" Foreground="#5A5FD0"/>
                        <TextBlock Name="Letter2" Text="e" FontSize="40" FontWeight="Bold" Foreground="#7B3FF2"/>
                        <TextBlock Name="Letter3" Text="l" FontSize="40" FontWeight="Bold" Foreground="#00B7C3"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Border Background="#F59E0B" CornerRadius="6" Padding="8,3">
                            <TextBlock Text="测试版" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </Border>
                        <Border Classes="chip">
                            <TextBlock Text="BSD-3 开源" FontSize="11" Foreground="#0067c0"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Name="ChineseName"
                               Text="Vael"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0067c0"
                               HorizontalAlignment="Center"
                               Opacity="0" />

                    <TextBlock Name="LineDesc"
                               Text="多功能 Windows 工具箱 · 小组件 · 插件系统"
                               FontSize="12"
                               Opacity="0.6"
                               HorizontalAlignment="Center"/>

                    <Border Name="Divider"
                            Height="1" Width="180"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Margin="0,8"
                            Opacity="0" />
                </StackPanel>
            </Border>

            <!-- ============ 信息卡 ============ -->
            <Border Classes="info-card">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                        <Style Selector="Grid > Border.row-line">
                            <Setter Property="Height" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="Margin" Value="0,9"/>
                        </Style>
                    </Grid.Styles>

                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="row-label" Text="版本" Margin="0,0,28,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="row-value" Name="LineVersion" Text="0.5.8" Opacity="0"/>

                    <Border Grid.Row="1" Classes="row-line"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="row-label" Text="技术栈" Margin="0,0,28,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="chip"><TextBlock Text=".NET 8" FontSize="11" Foreground="#0067c0"/></Border>
                        <Border Classes="chip"><TextBlock Text="Avalonia 11" FontSize="11" Foreground="#0067c0"/></Border>
                        <Border Classes="chip"><TextBlock Text="FluentAvalonia" FontSize="11" Foreground="#0067c0"/></Border>
                    </StackPanel>

                    <Border Grid.Row="3" Grid.Column="0" Classes="row-line"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="row-label" Text="构建" Margin="0,0,28,0" Grid.ColumnSpan="1"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="row-value" Name="LineBuild"
                               Text="基于 C# / .NET 8 + Avalonia UI 构建" Opacity="0"/>
                </Grid>
            </Border>

            <!-- ============ 制作人员卡 ============ -->
            <Border Name="CreditsSection" Classes="info-card" Opacity="0">                <StackPanel Spacing="14">
                    <TextBlock Text="制作人员"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="36">

                            <!-- TIANJING -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="72" Height="72"
                                        CornerRadius="36"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        PointerPressed="TianjingAvatar_PointerPressed">
                                    <Image x:Name="TJImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="TIANJING"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="开发者"
                                           FontSize="11"
                                           Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- deepseek -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="72" Height="72"
                                        CornerRadius="36"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        PointerPressed="DeepseekAvatar_PointerPressed">
                                    <Image x:Name="DeepImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="deepseek"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="蓝色大肥鱼"
                                           FontSize="11"
                                           Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- shinecy -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Border Width="72" Height="72"
                                        CornerRadius="36"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center">
                                    <Image x:Name="ShinecyImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="shinecy"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="股东"
                                           FontSize="11"
                                           Opacity="0.55"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 彩蛋：气泡 + 白饭 -->
                        <Canvas x:Name="EggCanvas" IsHitTestVisible="False">
                            <Border x:Name="RiceBubble"
                                    Background="#EE2D2D2D"
                                    CornerRadius="10"
                                    Padding="10,6"
                                    Opacity="0">
                                <TextBlock Text="我要吃白饭"
                                           FontSize="12"
                                           Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="RiceBowl"
                                       Text="🍚"
                                       FontSize="30"
                                       Opacity="0"/>
                        </Canvas>
                    </Grid>

                    <TextBlock Name="LineAuthor"
                               Text="Vael 项目组制作"
                               FontSize="12"
                               Opacity="0.65"
                               HorizontalAlignment="Center"/>
                    <TextBlock Name="LineTeam"
                               Text="tianjing &amp; deepseek"
                               FontSize="11"
                               Opacity="0.5"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ============ 链接 ============ -->
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Opacity="0"
                        x:Name="ButtonRow">

                <Button Name="GitHubButton"
                        Content="github.com/TIANJING-qwq/Vael"
                        FontSize="12"
                        Padding="14,7"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="#0067c0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Foreground="#0067c0"
                        Cursor="Hand"
                        Click="GitHubButton_Click" />
            </StackPanel>

            <TextBlock Name="UpdateStatusText"
                       Text=""
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="420"
                       Opacity="0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
