<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">

    <UserControl.Styles>
        <!-- 头像：强调色描边 + 悬停光晕 -->
        <Style Selector="Border.avatar">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#660067C0"/>
            <Setter Property="BoxShadow" Value="0 4 14 rgba(0,103,192,0.25)"/>
        </Style>
        <Style Selector="Border.avatar:pointerover">
            <Setter Property="BorderBrush" Value="#0067C0"/>
            <Setter Property="BoxShadow" Value="0 6 22 rgba(0,103,192,0.5)"/>
        </Style>
        <!-- 玻璃胶囊（放渐变上） -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#26000000"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="11,4"/>
        </Style>
        <!-- 角色小胶囊 -->
        <Style Selector="Border.role">
            <Setter Property="Background" Value="#140078D4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22" MaxWidth="640" Spacing="16" HorizontalAlignment="Stretch">

            <!-- ============ 渐变横幅 ============ -->
            <Border CornerRadius="18" ClipToBounds="True" Height="196">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0067C0" Offset="0"/>
                        <GradientStop Color="#5A5FD0" Offset="0.5"/>
                        <GradientStop Color="#00B7C3" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- 光斑装饰 -->
                    <Border Width="220" Height="220" CornerRadius="110"
                            Background="#22FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-70,-70,0,0"/>
                    <Border Width="150" Height="150" CornerRadius="75"
                            Background="#1AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-40,-40"/>

                    <Grid Margin="28,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 图标：白环 -->
                        <Border Grid.Column="0" Width="86" Height="86" CornerRadius="20"
                                Background="#40000000" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                Margin="0,0,22,0" VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image Name="AppIcon" Source="/Assets/app.png"
                                   Width="64" Height="64" Stretch="Uniform" Opacity="0"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                            <StackPanel Name="TitlePanel" Orientation="Horizontal" Spacing="1">
                                <TextBlock Name="Letter0" Text="V" FontSize="40" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Name="Letter1" Text="a" FontSize="40" FontWeight="Bold" Foreground="#E8FFFFFF"/>
                                <TextBlock Name="Letter2" Text="e" FontSize="40" FontWeight="Bold" Foreground="#E8FFFFFF"/>
                                <TextBlock Name="Letter3" Text="l" FontSize="40" FontWeight="Bold" Foreground="#E8FFFFFF"/>
                            </StackPanel>

                            <TextBlock Name="ChineseName" Text="Vael" FontSize="13" Foreground="#E8FFFFFF"
                                       FontWeight="SemiBold" Opacity="0"/>

                            <TextBlock Name="LineDesc" Text="多功能 Windows 工具箱 · 小组件 · 插件系统"
                                       FontSize="13" Foreground="#D9FFFFFF" Opacity="0"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Border Background="#F59E0B" CornerRadius="999" Padding="11,4">
                                    <TextBlock Text="测试版" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                                </Border>
                                <Border Classes="pill">
                                    <TextBlock Name="LineVersion" Text="版本 0.5.8" FontSize="11" Foreground="White" Opacity="0"/>
                                </Border>
                                <Border Classes="pill">
                                    <TextBlock Text="BSD-3 开源" FontSize="11" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 隐藏动画锚点 -->
                    <Border Name="Divider" Height="1" Width="0" Background="Transparent" Opacity="0"/>
                </Grid>
            </Border>

            <!-- ============ 元信息条 ============ -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <TextBlock Name="LineBuild" Text="基于 C# / .NET 8 + Avalonia UI 构建"
                           FontSize="12" Opacity="0"/>
                <TextBlock Text="·" FontSize="12" Opacity="0.35"/>
                <TextBlock Name="LineAuthor" Text="Vael 项目组制作" FontSize="12" Opacity="0"/>
                <TextBlock Text="·" FontSize="12" Opacity="0.35"/>
                <TextBlock Name="LineTeam" Text="tianjing &amp; deepseek" FontSize="12" Opacity="0"/>
            </StackPanel>

            <!-- ============ 制作人员 ============ -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="24,18"
                    Name="CreditsSection" Opacity="0">
                <StackPanel Spacing="14">
                    <TextBlock Text="制作人员" FontSize="14" FontWeight="SemiBold"
                               Opacity="0.75" HorizontalAlignment="Center"/>

                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="40">
                            <!-- TIANJING -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Width="96">
                                <Border Classes="avatar" Width="72" Height="72" CornerRadius="36"
                                        ClipToBounds="True" HorizontalAlignment="Center"
                                        Cursor="Hand" PointerPressed="TianjingAvatar_PointerPressed">
                                    <Image x:Name="TJImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="TIANJING" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <Border Classes="role" HorizontalAlignment="Center">
                                    <TextBlock Text="开发者" FontSize="10" Foreground="#0067C0"/>
                                </Border>
                            </StackPanel>

                            <!-- deepseek -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Width="96">
                                <Border Classes="avatar" Width="72" Height="72" CornerRadius="36"
                                        ClipToBounds="True" HorizontalAlignment="Center"
                                        Cursor="Hand" PointerPressed="DeepseekAvatar_PointerPressed">
                                    <Image x:Name="DeepImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="deepseek" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <Border Classes="role" HorizontalAlignment="Center">
                                    <TextBlock Text="蓝色大肥鱼" FontSize="10" Foreground="#0067C0"/>
                                </Border>
                            </StackPanel>

                            <!-- shinecy -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Width="96">
                                <Border Classes="avatar" Width="72" Height="72" CornerRadius="36"
                                        ClipToBounds="True" HorizontalAlignment="Center">
                                    <Image x:Name="ShinecyImage" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="shinecy" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <Border Classes="role" HorizontalAlignment="Center">
                                    <TextBlock Text="股东" FontSize="10" Foreground="#0067C0"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 彩蛋：气泡 + 白饭 -->
                        <Canvas x:Name="EggCanvas" IsHitTestVisible="False">
                            <Border x:Name="RiceBubble"
                                    Background="#EE2D2D2D" CornerRadius="10" Padding="10,6" Opacity="0">
                                <TextBlock Text="我要吃白饭" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="RiceBowl" Text="🍚" FontSize="30" Opacity="0"/>
                        </Canvas>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 链接 ============ -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        Margin="0,2,0,0" Opacity="0" x:Name="ButtonRow">
                <Button Name="GitHubButton" Content="github.com/TIANJING-qwq/Vael"
                        FontSize="12" Padding="16,8"
                        Background="#0067C0" Foreground="White" BorderThickness="0"
                        CornerRadius="18" Cursor="Hand" Click="GitHubButton_Click"/>
            </StackPanel>

            <TextBlock Name="UpdateStatusText" Text="" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,4"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Opacity="0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
