<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.UpdateView">
    <ScrollViewer>
        <StackPanel Margin="24,16" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="更新" FontSize="28" FontWeight="Bold" />

            <!-- 版本信息卡 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Vael v" /><Run x:Name="VerRun" Text="0.0.0" />
                    </TextBlock>
                    <TextBlock Opacity="0.7" FontSize="13">
                        <Run Text="代号 " /><Run x:Name="CodenameRun" Text="-" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 操作区 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CheckUpdateButton" Content="检查更新"
                        Click="CheckUpdateButton_Click" MinWidth="120" />
                <Button x:Name="ForceUpdateButton" Content="强制测试更新"
                        Click="ForceUpdateButton_Click" MinWidth="140"
                        ToolTip.Tip="忽略版本比较，强制走一次完整更新流程（测试用）" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.7" FontSize="13" Text="就绪" TextWrapping="Wrap" />

            <!-- 此版本更新内容 -->
            <TextBlock Text="此版本更新" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" FontSize="13" LineHeight="22"
                           Text="- 加载中…" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
