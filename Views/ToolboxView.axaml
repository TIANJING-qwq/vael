<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.ToolboxView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,16,20,12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,10">
            <TextBlock Text="实用工具箱" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="#2D0078D4" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="参考图吧工具箱 · 硬件检测/测试/内置工具" FontSize="12" Foreground="#60CDFF" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,200,Auto" Margin="0,0,0,10">
            <TextBox Name="SearchBox" Watermark="🔍 搜索工具（如：硬盘 / 坏点 / 温度）" CornerRadius="8"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox Name="CategoryCombo" Grid.Column="1" Margin="12,0,0,0"
                      SelectionChanged="CategoryCombo_SelectionChanged" />
            <TextBlock Name="CountText" Grid.Column="2" Text="" FontSize="13" Opacity="0.6"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="6" MaxWidth="980" Margin="0,0,8,0">
                <ItemsControl Name="ToolList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,4" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TagText}" FontSize="10" Opacity="0.55"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.62"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Content="{Binding ButtonText}" Tag="{Binding}" Click="ToolButton_Click"
                                            Padding="14,5" CornerRadius="6" FontSize="12"
                                            Background="#0078D4" Foreground="White" BorderThickness="0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="EmptyHint" Text="没有匹配的工具。" IsVisible="False" HorizontalAlignment="Center"
                           FontSize="13" Opacity="0.5" Margin="0,24" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
