<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.OptimizationCatalogView">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,16,20,12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,12">
            <TextBlock Text="优化大全" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="#2D0078D4" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="搜索 · 一键应用 · 可还原" FontSize="12" Foreground="#60CDFF" />
            </Border>
            <Button Name="ApplySafeButton" Content="⚡ 一键应用全部安全项" Click="ApplySafeButton_Click"
                    Padding="14,6" CornerRadius="6" Background="#0078D4" Foreground="White"
                    BorderThickness="0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Name="SearchBox" Watermark="🔍 搜索优化项（如：DNS / 休眠 / 菜单）" CornerRadius="8"
                     TextChanged="SearchBox_TextChanged" />
            <TextBlock Name="CountText" Grid.Column="1" Text="" FontSize="13" Opacity="0.6"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <!-- ================= 分类方块卡片 ================= -->
        <WrapPanel Name="CategoryCardsHost" Grid.Row="2" Margin="0,0,12,14" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="6" MaxWidth="980" Margin="0,0,8,0">
                <ItemsControl Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,4" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="8" CornerRadius="4" Margin="0,0,12,0"
                                            Background="{Binding RiskBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RiskText}" FontSize="10" Opacity="0.55"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="⟳重启" FontSize="10" Opacity="0.5"
                                                       VerticalAlignment="Center" IsVisible="{Binding Restart}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Opacity="0.62"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="应用" Tag="{Binding}" Click="ApplyButton_Click"
                                                Padding="12,4" CornerRadius="6" FontSize="12"
                                                Background="#0078D4" Foreground="White" BorderThickness="0" />
                                        <Button Content="还原" Tag="{Binding}" Click="RevertButton_Click"
                                                Padding="12,4" CornerRadius="6" FontSize="12" IsEnabled="{Binding HasRevert}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="EmptyHint" Text="没有匹配的优化项。" IsVisible="False" HorizontalAlignment="Center"
                           FontSize="13" Opacity="0.5" Margin="0,24" />
                <Border Background="#14000000" CornerRadius="10" Padding="14" Margin="0,14,0,4"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="执行日志" FontSize="12.5" FontWeight="SemiBold" Opacity="0.8" />
                        <StackPanel Name="LogPanel" Spacing="2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
