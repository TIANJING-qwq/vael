<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.WindowsProblemsView">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20,24,16">

        <!-- ================= 顶部：标题 + 搜索 ================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,0,0,12">
            <TextBlock Text="Windows 常见问题" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="#2D0078D4" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="分类速查 · 一键修复" FontSize="12" Foreground="#60CDFF" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Name="SearchBox" Watermark="🔍 搜索问题（关键词，如：蓝屏 / 没声音 / C盘）"
                     CornerRadius="8" TextChanged="SearchBox_TextChanged" />
            <TextBlock Name="CountText" Grid.Column="1" Text=""
                       FontSize="13" Opacity="0.6" VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <!-- ================= 分类方块卡片 ================= -->
        <WrapPanel Name="CategoryCardsHost" Grid.Row="2" Margin="0,0,12,14" />

        <!-- ================= 问题列表 ================= -->
        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="8" MaxWidth="960" Margin="0,0,8,0">

                <ItemsControl Name="ProblemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,4">
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8">
                                            <Border Background="#1A0078D4" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#60CDFF" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Spacing="10" Margin="26,4,18,14">
                                        <TextBlock Text="{Binding Symptom}" FontSize="12" Opacity="0.6"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="12.5" Opacity="0.85" TextWrapping="Wrap"
                                                   Text="{Binding Manual}" />
                                        <ItemsControl ItemsSource="{Binding Auto}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Tag="{Binding}"
                                                            Click="AutoActionButton_Click"
                                                            Padding="14,6" Margin="0,0,8,8" CornerRadius="6"
                                                            Background="#0078D4" Foreground="White"
                                                            BorderThickness="0" FontSize="12" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="此问题暂无自动方案，请按上方文字方法操作。"
                                                   FontSize="11.5" Opacity="0.45" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasAuto, Converter={x:Static BoolConverters.Not}}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Name="EmptyHint" Text="没有匹配的问题，换个关键词试试。"
                           IsVisible="False" HorizontalAlignment="Center"
                           FontSize="13" Opacity="0.5" Margin="0,24" />

                <!-- ================= 操作日志 ================= -->
                <Border Background="#14000000" CornerRadius="10" Padding="16" Margin="0,16,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="操作日志" FontSize="13" FontWeight="SemiBold" Opacity="0.8" />
                        <StackPanel Name="LogPanel" Spacing="2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
