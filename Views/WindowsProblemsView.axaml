<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.WindowsProblemsView">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="920">

            <TextBlock Text="Windows 常见问题" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="每个问题都提供「文字方法」与「一键自动解决」（自动操作多数需要管理员权限）"
                       FontSize="14" Opacity="0.6" TextWrapping="Wrap" />

            <!-- ① 资源管理器无限重启 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="① 资源管理器无限重启 / 桌面反复闪断" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="现象：桌面、任务栏不停闪断重启，反复刷新。" FontSize="12" Opacity="0.6" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：在桌面打开控制面板（没有图标可按 Ctrl+Shift+Esc 打开任务管理器 → 左上角「文件」→「运行新任务」→ 输入 control 回车）→「时钟和区域」→「更改时区」→ 再点一次「更改时区」→ 直接点「确定」（不用选择时区）→ 再点「确定」即可。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="打开控制面板" Click="OpenControlPanel_Click" Padding="14,6" CornerRadius="6"
                                Background="#0078D4" Foreground="White" BorderThickness="0" />
                        <Button Content="重启资源管理器" Click="RestartExplorer_Click" Padding="14,6" CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ② 系统更新后闪屏 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="② 系统更新后闪屏 / 不适配" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="现象：刚更新完系统后屏幕闪烁、驱动/桌面异常（多为更新与硬件不兼容）。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：按 Ctrl+Alt+Del，按住 Shift 不放 → 点右下角「重启」→ 进入「疑难解答」→「高级选项」→「卸载更新」→「卸载最近的质量更新」→ 继续；进入系统后确认正常，再点「完成」。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="查看已安装更新（供卸载参考）" Click="ListUpdates_Click" Padding="14,6" CornerRadius="6" />
                        <Button Content="打开「更新历史」" Click="OpenUpdateHistory_Click" Padding="14,6" CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ③ 任务栏 / 开始菜单无响应 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="③ 任务栏 / 开始菜单点击无响应" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：任务管理器（Ctrl+Shift+Esc）→ 找到「Windows 资源管理器」→ 右键「重新启动」。" />
                    <Button Content="一键重启资源管理器" Click="RestartExplorer_Click" Padding="14,6" CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- ④ 网络异常 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="④ 网络连不上 / 网络重置" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：设置 → 网络和 Internet → 高级网络设置 → 网络重置（会重启电脑）。或命令行执行 netsh winsock reset 后重启。" />
                    <Button Content="执行 netsh winsock reset" Click="ResetNetwork_Click" Padding="14,6" CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- ⑤ 图标缓存异常 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="⑤ 图标变白 / 图标缓存异常" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：删除 %LocalAppData%\IconCache.db 并重启资源管理器即可重建图标缓存。" />
                    <Button Content="一键重建图标缓存" Click="RebuildIconCache_Click" Padding="14,6" CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- ⑥ 系统文件损坏 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="⑥ 系统文件损坏 / 蓝屏后修复" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Opacity="0.8"
                               Text="文字方法：管理员命令行执行 sfc /scannow 与 DISM /Online /Cleanup-Image /RestoreHealth。" />
                    <Button Content="一键 SFC + DISM 修复" Click="RepairSystemFiles_Click" Padding="14,6" CornerRadius="6" />
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <TextBlock Text="操作日志" FontSize="17" FontWeight="SemiBold" />
            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1"
                    CornerRadius="6" Padding="10" MaxHeight="160">
                <ScrollViewer>
                    <StackPanel x:Name="LogPanel" Spacing="2" />
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
