<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ea="using:Avalonia.Animation.Easings"
             x:Class="SBtools.Views.OptimizationView">

    <UserControl.Styles>
        <!-- 分类卡片：悬停放大 + 按下回弹 -->
        <Style Selector="Button.optCard">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22">
                        <TransformOperationsTransition.Easing>
                            <ea:BackEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.optCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.optCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="系统优化" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="选择性优化 Windows 系统，每项都可随时还原（部分不可逆项已标注）"
                       FontSize="14" Opacity="0.6" />
        </StackPanel>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Name="OptimizationStatusText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Opacity="0.7"
                               Text="共 0 项已启用 / 30 项可选" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="ApplyRecommendedButton"
                            Content="一键应用推荐项"
                            Padding="14,6"
                            CornerRadius="6"
                            Background="#0078D4"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ApplyRecommendedButton_Click" />
                    <Button Name="RefreshStatusButton"
                            Content="刷新状态"
                            Padding="14,6"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Click="RefreshStatusButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="2">

            <!-- ===== 分类卡片（默认） ===== -->
            <ScrollViewer x:Name="CategoryCardsView">
                <WrapPanel Margin="0,2">

                    <Button Click="ServicesCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="⚙️" FontSize="26" />
                            <TextBlock Text="服务优化" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="关闭不必要的系统服务" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="AiCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="🤖" FontSize="26" />
                            <TextBlock Text="AI 组件" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="管理 AI 相关系统组件" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="PrivacyCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="🔒" FontSize="26" />
                            <TextBlock Text="隐私" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="关闭遥测与数据上报" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="PerformanceCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="⚡" FontSize="26" />
                            <TextBlock Text="性能" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="游戏/前台性能优化" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="CleanupCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="🧹" FontSize="26" />
                            <TextBlock Text="清理" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="清理临时文件与缓存" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="SystemToolsCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="🛠" FontSize="26" />
                            <TextBlock Text="系统工具" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="系统修复 · 备份 · 更新管理" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="CatalogCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="⚡" FontSize="26" />
                            <TextBlock Text="优化大全" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="实用优化 · 搜索 · 一键应用" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                    <Button Click="ToolboxCard_Click" Classes="optCard"
                            Width="240" Height="118" Margin="0,0,14,14"
                            Padding="0" HorizontalContentAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel Margin="18,14" Spacing="6">
                            <TextBlock Text="🧰" FontSize="26" />
                            <TextBlock Text="实用工具箱" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="硬件检测 · 烤机 · 屏幕测试（参考图吧）" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </ScrollViewer>

            <!-- ===== 分类详情（点击卡片进入） ===== -->
            <ScrollViewer x:Name="CategoryDetailView" IsVisible="False">
                <StackPanel Margin="0,2" Spacing="14">

                    <Button Content="← 返回分类"
                            Click="BackToCategories_Click"
                            HorizontalAlignment="Left"
                            Padding="14,8"
                            CornerRadius="6" />

                    <TextBlock x:Name="DetailTitle"
                               FontSize="20"
                               FontWeight="Bold" />

                    <StackPanel Name="ServicesPanel" Spacing="10" IsVisible="False" />
                    <StackPanel Name="AiPanel" Spacing="10" IsVisible="False" />
                    <StackPanel Name="PrivacyPanel" Spacing="10" IsVisible="False" />
                    <StackPanel Name="PerformancePanel" Spacing="10" IsVisible="False" />
                    <StackPanel Name="CleanupPanel" Spacing="10" IsVisible="False" />

                    <ContentControl Name="SystemToolsHost" IsVisible="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部日志 -->
        <Border Grid.Row="3"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,12,0,0"
                MaxHeight="120">
            <ScrollViewer Name="StatusScrollViewer">
                <StackPanel Name="StatusLogPanel" Spacing="2" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
